{
  "name": "gentransit",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm -F @gentransit/shared build && pnpm -r --parallel --filter \"./apps/**\" --filter \"./packages/**\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -F @gentransit/shared build && pnpm -r typecheck",
    "test": "pnpm -F @gentransit/shared build && pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm -r build && pnpm -F @gentransit/web test:e2e",
    "db:migrate": "pnpm -F @gentransit/server db:migrate",
    "db:seed": "pnpm -F @gentransit/server db:seed",
    "prototype": "pnpm --dir prototype install && pnpm --dir prototype dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
