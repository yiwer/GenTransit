// GenTransit 数据模型（M1）。说明见 docs/planning/2026-10-28-m1-plan.md 第 3 节；站牌集结构见 M3 计划 3.1 节；只读 API 与 Token 见 M4 计划 3.10 节
// 名称类字段在迁移里使用 COLLATE "zh-x-icu"，按拼音排序

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/**
 * ---------------- 账号、设置、上传 ----------------
 */

model Account {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  passwordHash String
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  accountId  String   @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId])
}

enum OrientationMode {
  orientation
  code
}

/// 单行设置表，id 固定为 1
model Setting {
  id              Int             @id @default(1)
  orientationMode OrientationMode @default(orientation)
  landmarkLimit   Int             @default(5)
  autoMatch       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum ExtOwner {
  stop
  line
  routeStop
}

enum ExtType {
  text
  select
  number
  date
  time
  textList
}

enum StopSection {
  basic
  facility
  other
}

model ExtField {
  id          String       @id @default(uuid(7)) @db.Uuid
  owner       ExtOwner
  key         String
  name        String
  type        ExtType
  options     String[]
  description String       @default("")
  section     StopSection?
  enabled     Boolean      @default(true)
  sort        Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([owner, key])
  @@unique([owner, name])
  @@index([updatedAt, id])
}

model Upload {
  id             String          @id @default(uuid(7)) @db.Uuid
  path           String
  originalName   String
  mime           String
  size           Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companies      BusCompany[]
  stopPhotos     StopPhoto[]
  shelfTemplates ShelfTemplate[]
}

/**
 * ---------------- 基础数据与地标 ----------------
 */

enum DictCategory {
  shelfType
  maintainer
  road
  fareSystem
  platformType
  safety
  shelterType
}

model DictItem {
  id        String       @id @default(uuid(7)) @db.Uuid
  category  DictCategory
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  roadStops         Stop[]          @relation("StopRoad")
  platformTypeStops Stop[]          @relation("StopPlatformType")
  safetyStops       Stop[]          @relation("StopSafety")
  shelterTypeStops  Stop[]          @relation("StopShelterType")
  maintainerStops   Stop[]          @relation("StopMaintainer")
  fareSystemLines   Line[]          @relation("LineFareSystem")
  shelves           Shelf[]
  shelfTemplates    ShelfTemplate[]

  @@unique([category, name])
  @@index([updatedAt, id])
}

enum RegionLevel {
  city
  district
  street
}

model Region {
  id        String      @id @default(uuid(7)) @db.Uuid
  level     RegionLevel
  parentId  String?     @db.Uuid
  parent    Region?     @relation("RegionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Region[]    @relation("RegionTree")
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  cityStops     Stop[] @relation("StopCity")
  districtStops Stop[] @relation("StopDistrict")
  streetStops   Stop[] @relation("StopStreet")

  @@unique([parentId, name])
  @@index([updatedAt, id])
}

model BusCompany {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  nameEn    String   @default("")
  shortName String   @default("")
  logoId    String?  @db.Uuid
  logo      Upload?  @relation(fields: [logoId], references: [id], onDelete: Restrict)
  hotline   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines     Line[]

  @@index([updatedAt, id])
}

model LandmarkCategory {
  id            String     @id @default(uuid(7)) @db.Uuid
  name          String     @unique
  icon          String     @default("landmark")
  defaultRadius Int
  enabled       Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  landmarks     Landmark[]

  @@index([updatedAt, id])
}

model Landmark {
  id         String           @id @default(uuid(7)) @db.Uuid
  name       String
  nameEn     String           @default("")
  categoryId String           @db.Uuid
  category   LandmarkCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  points     LandmarkPoint[]
  stops      StopLandmark[]

  @@index([categoryId])
  @@index([updatedAt, id])
}

model LandmarkPoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  landmarkId String   @db.Uuid
  landmark   Landmark @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  lng        Float
  lat        Float
  radius     Int
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([landmarkId])
}

/**
 * ---------------- 站点与站牌集 ----------------
 */

model Stop {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  /// 方位或编码，统一存文本
  direction      String
  nameEn         String    @default("")
  lng            Float
  lat            Float
  cityId         String?   @db.Uuid
  city           Region?   @relation("StopCity", fields: [cityId], references: [id], onDelete: Restrict)
  districtId     String?   @db.Uuid
  district       Region?   @relation("StopDistrict", fields: [districtId], references: [id], onDelete: Restrict)
  streetId       String?   @db.Uuid
  street         Region?   @relation("StopStreet", fields: [streetId], references: [id], onDelete: Restrict)
  roadId         String?   @db.Uuid
  road           DictItem? @relation("StopRoad", fields: [roadId], references: [id], onDelete: Restrict)
  qrUrl          String    @default("")
  berths         Int?
  platformTypeId String?   @db.Uuid
  platformType   DictItem? @relation("StopPlatformType", fields: [platformTypeId], references: [id], onDelete: Restrict)
  safetyId       String?   @db.Uuid
  safety         DictItem? @relation("StopSafety", fields: [safetyId], references: [id], onDelete: Restrict)
  waiting        String    @default("")
  shelterTypeId  String?   @db.Uuid
  shelterType    DictItem? @relation("StopShelterType", fields: [shelterTypeId], references: [id], onDelete: Restrict)
  bigLightbox    Int?
  smallLightbox  Int?
  seats          Int?
  maintainerId   String?   @db.Uuid
  maintainer     DictItem? @relation("StopMaintainer", fields: [maintainerId], references: [id], onDelete: Restrict)
  remark         String    @default("")
  ext            Json      @default("{}")
  rev            Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  landmarks  StopLandmark[]
  photos     StopPhoto[]
  signSet    SignSet?
  routeStops RouteStop[]

  @@unique([name, direction])
  @@index([districtId])
  @@index([streetId])
  @@index([roadId])
  @@index([maintainerId])
  @@index([updatedAt, id])
}

model StopLandmark {
  stopId     String   @db.Uuid
  stop       Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  landmarkId String   @db.Uuid
  landmark   Landmark @relation(fields: [landmarkId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([stopId, landmarkId])
  @@index([landmarkId])
}

model StopPhoto {
  id        String   @id @default(uuid(7)) @db.Uuid
  stopId    String   @db.Uuid
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  uploadId  String   @db.Uuid
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  sort      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stopId])
  @@index([uploadId])
}

/// 每个站点恰有一个站牌集；整个站牌集带 rev 一次保存（BR-18）
model SignSet {
  id        String     @id @default(uuid(7)) @db.Uuid
  stopId    String     @unique @db.Uuid
  stop      Stop       @relation(fields: [stopId], references: [id], onDelete: Cascade)
  reminder  String     @default("")
  rev       Int        @default(1)
  /// 只读 API 的"有变化"时间：自身快照写入、线路引起的途经变化（M4 计划 3.5 节）；不碰 rev 与 updatedAt
  changedAt DateTime   @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shelves   Shelf[]
  boards    Board[]
  schedules Schedule[]

  @@index([changedAt, id])
}

enum BoardFace {
  front
  back
  A
  B
  C
  D
  E
  F
}

enum BoardKind {
  whole
  sliced
}

enum SlotKind {
  route
  other
}

enum Placement {
  board
  slot
  hidden
}

/// 站架：ID 由前端生成（保存时整体替换，ID 稳定）；sort 即立面上从左到右的顺序
model Shelf {
  id         String   @id @db.Uuid
  signSetId  String   @db.Uuid
  signSet    SignSet  @relation(fields: [signSetId], references: [id], onDelete: Cascade)
  typeId     String   @db.Uuid
  type       DictItem @relation(fields: [typeId], references: [id], onDelete: Restrict)
  no         Int
  name       String   @default("")
  desc       String   @default("")
  noPhysical Boolean  @default(false)
  material   String   @default("")
  sort       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  boards     Board[]

  @@unique([signSetId, no])
  @@index([typeId])
}

/// 站牌：signSetId 冗余，用于站牌集内编号唯一
model Board {
  id        String     @id @db.Uuid
  shelfId   String     @db.Uuid
  shelf     Shelf      @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  signSetId String     @db.Uuid
  signSet   SignSet    @relation(fields: [signSetId], references: [id], onDelete: Cascade)
  no        Int
  face      BoardFace
  kind      BoardKind
  width     Int
  height    Int
  remark    String     @default("")
  sort      Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  slots     Slot[]
  schedules Schedule[]

  @@unique([signSetId, no])
  @@index([shelfId])
}

model Slot {
  id        String     @id @db.Uuid
  boardId   String     @db.Uuid
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  no        Int
  kind      SlotKind
  note      String     @default("")
  width     Int
  height    Int
  sort      Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]

  @@unique([boardId, no])
}

/// 线路编排：一次途经（走向，第几次途经）在本站的放置或隐藏（BR-05～BR-07）。
/// 放在插片上时同时记下插片所在的站牌。部分唯一索引在迁移里手写：
/// 每个插片最多一条；同一途经在同一块站牌最多一次；同一途经最多一条隐藏。
/// 走向外键用 Restrict：删除走向前必须先经过 RouteRemovalHook 删除编排（BR-10）
model Schedule {
  id        String    @id @default(uuid(7)) @db.Uuid
  signSetId String    @db.Uuid
  signSet   SignSet   @relation(fields: [signSetId], references: [id], onDelete: Cascade)
  routeId   String    @db.Uuid
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  pass      Int
  placement Placement
  boardId   String?   @db.Uuid
  board     Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  slotId    String?   @db.Uuid
  slot      Slot?     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  order     Int?
  createdAt DateTime  @default(now())

  @@index([signSetId])
  @@index([routeId])
  @@index([boardId])
}

/// 站架模板：结构不被别处引用，整块存 JSONB；套用时复制，站架与模板之间不保留关联（BR-14）
model ShelfTemplate {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  typeId     String   @db.Uuid
  type       DictItem @relation(fields: [typeId], references: [id], onDelete: Restrict)
  desc       String   @default("")
  noPhysical Boolean  @default(false)
  imageId    String?  @db.Uuid
  image      Upload?  @relation(fields: [imageId], references: [id], onDelete: Restrict)
  /// { face, kind, width, height, remark, slots: { no, kind, note, width, height }[] }[]
  boards     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([typeId, name])
  @@index([updatedAt, id])
}

/**
 * ---------------- 线路（M1 只建表，界面与接口在 M2） ----------------
 */

enum LineMode {
  oneway
  twoway
  loop
  doubleLoop
}

enum LineStatus {
  running
  suspended
}

enum TicketType {
  attended
  unattended
}

enum RouteKind {
  up
  down
  inner
  outer
  oneway
  loop
}

enum ServiceType {
  scheduled
  interval
}

model Line {
  id           String      @id @default(uuid(7)) @db.Uuid
  name         String      @unique
  number       String      @unique
  nameEn       String      @default("")
  mode         LineMode
  companyId    String?     @db.Uuid
  company      BusCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ticketType   TicketType?
  fareSystemId String?     @db.Uuid
  fareSystem   DictItem?   @relation("LineFareSystem", fields: [fareSystemId], references: [id], onDelete: Restrict)
  fare         String      @default("")
  status       LineStatus  @default(running)
  ext          Json        @default("{}")
  rev          Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  routes       Route[]

  @@index([updatedAt, id])
}

model Route {
  id          String       @id @default(uuid(7)) @db.Uuid
  lineId      String       @db.Uuid
  line        Line         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  kind        RouteKind
  serviceType ServiceType?
  serviceTime String       @default("")
  interval    String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stops       RouteStop[]
  schedules   Schedule[]

  @@unique([lineId, kind])
}

model RouteStop {
  id        String   @id @default(uuid(7)) @db.Uuid
  routeId   String   @db.Uuid
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId    String   @db.Uuid
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Restrict)
  seq       Int
  times     String[]
  ext       Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, seq])
  @@index([stopId])
}

/**
 * ---------------- 修改快照 ----------------
 */

enum ObjectType {
  stop
  line
  signSet
}

enum SnapshotAction {
  create
  update
  delete
  importCreate
  importUpdate
  cascadeUpdate
}

model Snapshot {
  id          String         @id @default(uuid(7)) @db.Uuid
  objectType  ObjectType
  objectId    String         @db.Uuid
  objectName  String
  action      SnapshotAction
  note        String         @default("")
  content     Json
  compareHash String
  createdAt   DateTime       @default(now())

  @@index([objectType, objectId, createdAt(sort: Desc)])
  @@index([objectType, action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/**
 * ---------------- 导入（M2） ----------------
 */

enum ImportKind {
  stop
  line
}

enum ImportStatus {
  pending
  confirmed
  cancelled
  expired
}

/// 导入任务：上传后先分析出预览，确认时在一个事务里重新分析并比对计划哈希后写入
model ImportJob {
  id        String       @id @default(uuid(7)) @db.Uuid
  kind      ImportKind
  status    ImportStatus @default(pending)
  fileName  String
  /// 原文件（确认时重新分析、下载失败行都要用）
  file      Bytes
  options   Json         @default("{}")
  preview   Json
  /// 失败行的原始单元格，用于下载失败行
  failures  Json         @default("[]")
  planHash  String
  result    Json?
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([createdAt(sort: Desc)])
}

/**
 * ---------------- 只读 API（M4） ----------------
 */

/// API Token：库里只存明文的 SHA-256 与前 10 个字符；吊销即删除（M4 计划 2.1 节）
model ApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @unique
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum TombstoneType {
  landmark
  landmarkCategory
  dictItem
  region
  busCompany
  shelfTemplate
}

/// 墓碑：没有快照的对象被删除时，在同一事务里记下，供只读 API 的"已删除对象"使用；永久保留
model Tombstone {
  objectId  String        @id @db.Uuid
  type      TombstoneType
  name      String
  deletedAt DateTime      @default(now())

  @@index([deletedAt, objectId])
}
