# 复制为 .env 后填写；也可以直接设置为系统环境变量（系统环境变量优先）。不要提交真实值。
# 同一个 .env 在开发与 Docker 部署两种场景下都能用：部署时 docker-compose.yml 会覆盖 DATABASE_URL 等几项。

# ================= 共用 =================

# 会话令牌哈希用的密钥，至少 32 个字符
SESSION_SECRET=
# 初始账号：仅在数据库里还没有账号时用来创建，之后不再生效
GT_ADMIN_USERNAME=
GT_ADMIN_PASSWORD=
# 高德 JS API Key：会下发到浏览器，请在高德控制台绑定域名白名单
AMAP_JSAPI_KEY=
# 高德 JS API 安全密钥：只在服务端 /_AMapService 代理里附加，浏览器拿不到
AMAP_JSAPI_SECURITY_CODE=
# 高德 Web 服务 Key：服务端逆地理编码用
AMAP_WEB_SERVICE_KEY=
# 高德 Web 服务 Key：服务端按站序计算走向轨迹（驾车路线规划）用，只在服务端使用
AMAP_API_KEY=

# ================= 开发 =================

# PostgreSQL 连接串（开发库见 docker-compose.dev.yml，端口 54329）；Docker 部署时由 compose 覆盖
DATABASE_URL=
# 上传文件目录（默认 apps/server/uploads）；Docker 部署时固定为 /data/uploads
UPLOAD_DIR=
# 信任哪些代理的 X-Forwarded-*（决定 HTTPS 下 Cookie 是否加 Secure），默认 loopback；Docker 部署默认 loopback,uniquelocal
TRUST_PROXY=
# 应用读取备份状态的目录；不设时设置里的"备份"页签显示"未配置"。Docker 部署时固定为 /backups
BACKUP_DIR=

# ================= Docker 部署（docs/deploy.md） =================

# 数据库密码（必填）。会拼进连接串，请只用字母和数字
POSTGRES_PASSWORD=
# 对外端口，默认 8080
GT_HTTP_PORT=
# 使用的镜像标签，默认 latest（离线包里的 VERSION 文件写着具体标签）
GT_VERSION=
# 每日备份时间（备份容器的本地时间），默认 02:30
BACKUP_TIME=
# 备份保留天数，默认 30；始终保留最新一份
BACKUP_RETENTION_DAYS=
# 应用与备份容器的时区，默认 Asia/Shanghai；数据库容器不设，保持 UTC
TZ=
# 备份目录在宿主机上的位置，默认 ./backups
GT_BACKUP_PATH=
